# PortForge QUALIFICATION environment only (Phase 14 disposable stack).
# Copy to `.env.qual` (gitignored locally) before starting the qualification stack.
#
# NEVER put production secrets here by accident.
# NEVER point this file at production ports 58000 / 3000 / 55432
# or development ports 58001 / 3001 / 55433.

# Required — mint a disposable secret for the qualification stack only.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
PORTFORGE_QUAL_ADMIN_BOOTSTRAP_TOKEN=qual-example-bootstrap-token-not-a-real-secret

# Optional disposable DB password (defaults to "qual" in compose).
# PORTFORGE_QUAL_DB_PASSWORD=qual

# Optional image overrides (defaults build from current tree into :qual tags).
# PORTFORGE_QUAL_API_IMAGE=portforge-api:qual
# PORTFORGE_QUAL_DASHBOARD_IMAGE=portforge-dashboard:qual
