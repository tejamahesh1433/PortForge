# PortForge DEVELOPMENT environment only.
# Copy to `.env.dev` (gitignored locally) before starting the isolation stack.
#
# NEVER put production secrets here by accident.
# NEVER point this file at production ports 58000 / 3000 / 55432.

# Required — mint a disposable secret for the development stack only.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
PORTFORGE_DEV_ADMIN_BOOTSTRAP_TOKEN=

# Optional disposable DB password (defaults to "disposable" in compose).
# PORTFORGE_DEV_DB_PASSWORD=disposable

# Optional image overrides (defaults are the Phase 2 WIP tags).
# PORTFORGE_DEV_API_IMAGE=portforge-api:v1.3-phase2-wip
# PORTFORGE_DEV_DASHBOARD_IMAGE=portforge-dashboard:v1.3-phase2-wip
