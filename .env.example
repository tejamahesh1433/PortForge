# Copy to .env and fill in real values. .env is local-only and must never
# be committed -- see docs/architecture.md "Security assumptions".

# Required to mint enrollment tokens (POST /api/agent/enrollment-tokens).
# Generate one yourself, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
PORTFORGE_ADMIN_BOOTSTRAP_TOKEN=

# Optional overrides -- see backend/README.md "Choosing ports" for why
# these default higher than the standard 5432/8000 ranges.
# PORTFORGE_DB_HOST_PORT=55432
# PORTFORGE_API_HOST_PORT=58000
# PORTFORGE_DB_NAME=portforge
# PORTFORGE_DB_USER=portforge
# PORTFORGE_DB_PASSWORD=portforge
