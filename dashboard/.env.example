# Central's base URL. The dashboard never hardcodes this -- every API call
# goes through lib/api/config.ts, which reads it from here.
NEXT_PUBLIC_PORTFORGE_API_URL=http://127.0.0.1:58000

# Server-only admin secret (same value as Central). Powers Hosts → Add host
# and Remove record BFF routes. Never prefix with NEXT_PUBLIC_ — it must not
# ship to the browser.
# PORTFORGE_ADMIN_BOOTSTRAP_TOKEN=

# Optional server-only Central URL for BFF routes (Docker sets this to the
# internal service name). Falls back to NEXT_PUBLIC_PORTFORGE_API_URL.
# PORTFORGE_INTERNAL_API_URL=
